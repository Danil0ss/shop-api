<%- include('partials/header') %>

<div style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
  <h2>🛒 Корзина заказов</h2>
  <a href="/?auth=<%= user.isAuth ? '1' : '0' %>" class="btn btn-primary" style="font-size: 13px;">← Продолжить покупки</a>
</div>

<% if (orderSuccess) { %>
  <div class="card" style="border-left: 5px solid #38a169; background: #f0fff4;">
    <h3 style="color: #276749;">🎉 Спасибо за заказ!</h3>
    <p style="color: #2f855a; margin-top: 6px;">Ваш заказ успешно принят в обработку. Остатки на складе были обновлены.</p>
  </div>
<% } %>

<% if (cart.length === 0) { %>
  <div class="card" style="text-align: center; padding: 40px 20px;">
    <p style="font-size: 18px; color: #718096; margin-bottom: 16px;">Ваша корзина пуста</p>
    <a href="/?auth=<%= user.isAuth ? '1' : '0' %>" class="btn btn-success">Перейти к покупкам</a>
  </div>
<% } else { %>
  <div class="card" style="padding: 0; overflow-x: auto;">
    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 14px;">
      <thead>
        <tr style="background: #edf2f7; border-bottom: 1px solid #e2e8f0;">
          <th style="padding: 12px 16px;">Товар</th>
          <th style="padding: 12px 16px;">Категория</th>
          <th style="padding: 12px 16px;">Цена</th>
          <th style="padding: 12px 16px;">Кол-во</th>
          <th style="padding: 12px 16px;">Сумма</th>
          <th style="padding: 12px 16px;">Действие</th>
        </tr>
      </thead>
      <tbody>
        <% cart.forEach(item => { %>
          <tr style="border-bottom: 1px solid #edf2f7;">
            <td style="padding: 12px 16px;">
              <strong><%= item.product.title %></strong>
              <div style="font-size: 11px; color: #a0aec0; margin-top: 3px;">
                Добавлено в корзину: <%= item.addedAt %>
              </div>
            </td>
            <td style="padding: 12px 16px; color: #718096;"><%= item.product.category %></td>
            <td style="padding: 12px 16px;"><%= item.product.price %> BYN</td>
            <td style="padding: 12px 16px; font-weight: bold;"><%= item.quantity %> шт.</td>
            <td style="padding: 12px 16px; font-weight: bold; color: #2b6cb0;">
              <%= item.product.price * item.quantity %> BYN
            </td>
            <td style="padding: 12px 16px;">
              <form action="/cart/remove/<%= item.product.id %>?auth=<%= user.isAuth ? '1' : '0' %>" method="POST" style="margin: 0;">
                <button type="submit" class="btn btn-danger" style="font-size: 12px; padding: 4px 8px;">✕ Удалить</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="card" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
    <form action="/cart/clear?auth=<%= user.isAuth ? '1' : '0' %>" method="POST" style="margin: 0;">
      <button type="submit" class="btn" style="background: #e2e8f0; color: #4a5568;">Очистить корзину</button>
    </form>

    <div style="display: flex; align-items: center; gap: 20px;">
      <div style="font-size: 18px;">
        Итого к оплате: <strong style="color: #2b6cb0; font-size: 22px;"><%= totalPrice %> BYN</strong>
      </div>
      <form action="/cart/checkout?auth=<%= user.isAuth ? '1' : '0' %>" method="POST" style="margin: 0;">
        <button type="submit" class="btn btn-success" style="padding: 10px 20px; font-size: 15px;">
          ✓ Оформить заказ
        </button>
      </form>
    </div>
  </div>
<% } %>

<%- include('partials/footer') %>