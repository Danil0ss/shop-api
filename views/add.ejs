<%- include('partials/header') %>

<div class="card" style="max-width: 600px; margin: 0 auto;">
  <h2>Добавление нового товара в магазин</h2>
  <p style="font-size: 13px; color: #718096; margin-bottom: 16px;">Заполните поля формы. Все числовые значения должны быть >= 0.</p>

  <% if (errorMessage) { %>
    <div style="background: #fed7d7; color: #9b2c2c; padding: 10px 14px; border-radius: 6px; margin-bottom: 16px; font-size: 14px;">
      <%= errorMessage %>
    </div>
  <% } %>

  <form action="/add?auth=<%= user.isAuth ? '1' : '0' %>" method="POST">
    <div style="margin-bottom: 14px;">
      <label style="display: block; font-weight: 500; font-size: 13px; margin-bottom: 4px;">Название товара *</label>
      <input type="text" name="title" value="<%= formData.title || '' %>" required style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e0; border-radius: 6px;">
    </div>

    <div style="margin-bottom: 14px;">
      <label style="display: block; font-weight: 500; font-size: 13px; margin-bottom: 4px;">Категория *</label>
      <input type="text" name="category" value="<%= formData.category || '' %>" required style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e0; border-radius: 6px;">
    </div>

    <div style="display: flex; gap: 14px; margin-bottom: 14px;">
      <div style="flex: 1;">
        <label style="display: block; font-weight: 500; font-size: 13px; margin-bottom: 4px;">Цена (BYN, >= 0) *</label>
        <input type="number" step="0.01" min="0" name="price" value="<%= formData.price || '' %>" required style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e0; border-radius: 6px;">
      </div>
      <div style="flex: 1;">
        <label style="display: block; font-weight: 500; font-size: 13px; margin-bottom: 4px;">Количество на складе (>= 0) *</label>
        <input type="number" min="0" name="stockQuantity" value="<%= formData.stockQuantity || 0 %>" required style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e0; border-radius: 6px;">
      </div>
    </div>

    <div style="margin-bottom: 16px;">
      <label style="display: block; font-weight: 500; font-size: 13px; margin-bottom: 4px;">Описание товара</label>
      <textarea name="description" rows="3" style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e0; border-radius: 6px;"><%= formData.description || '' %></textarea>
    </div>

    <button type="submit" class="btn btn-primary" style="width: 100%; padding: 10px;">Сохранить товар</button>
  </form>
</div>

<%- include('partials/footer') %>